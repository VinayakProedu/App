rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'vinayakproedu@gmail.com'; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Student profiles: user reads/writes only their own doc; admin reads/writes all
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'student';
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Teaching content: everyone signed in can read; only admin can write
    match /lectures/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /batches/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /announcements/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mock papers & questions: readable by signed-in users; admin-only writes
    match /mockPapers/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /mockQuestions/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Attempts: students create only their own, read only their own; admin reads/updates (manual marking)
    match /mockAttempts/{doc} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Doubts: student creates/reads own; admin replies and manages
    match /studentDoubts/{doc} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Legacy test engine collections
    match /tests/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /questions/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /attempts/{doc} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
